<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
  <!-- Background - Rounded square like homepage -->
  <rect width="100" height="100" rx="24" fill="#FFB800"/>

  <!-- Material Symbol "local_florist" (flower) icon - Simplified -->
  <g transform="translate(50, 50)">
    <!-- Flower center -->
    <circle cx="0" cy="0" r="12" fill="#FFFFFF"/>

    <!-- Flower petals - 8 petals arranged in circle -->
    <g fill="#FFFFFF" opacity="0.9">
      <!-- Top petals -->
      <ellipse cx="0" cy="-28" rx="6" ry="14" />
      <ellipse cx="0" cy="28" rx="6" ry="14" />
      <ellipse cx="-28" cy="0" rx="14" ry="6" />
      <ellipse cx="28" cy="0" rx="14" ry="6" />

      <!-- Diagonal petals -->
      <ellipse cx="-20" cy="-20" rx="6" ry="14" transform="rotate(45, -20, -20)" />
      <ellipse cx="20" cy="20" rx="6" ry="14" transform="rotate(45, 20, 20)" />
      <ellipse cx="20" cy="-20" rx="14" ry="6" transform="rotate(45, 20, -20)" />
      <ellipse cx="-20" cy="20" rx="14" ry="6" transform="rotate(45, -20, 20)" />
    </g>

    <!-- Center dot -->
    <circle cx="0" cy="0" r="6" fill="#FFB800"/>
  </g>
</svg>
