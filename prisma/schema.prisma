// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id          String        @id @default(cuid())
  name        String
  phone       String
  nik         String        @unique
  entryDate   DateTime
  roomNumber  String?
  lastPayment DateTime?
  checkoutDate DateTime?
  Transaction Transaction[]
  Tenant      Tenant?       // NEW: One-to-one with Tenant

  user   User?   @relation(fields: [userId], references: [id])
  userId String?
}

model Transaction {
  id           String    @id @default(cuid())
  type         String // "revenue" or "expense"
  amount       Float
  date         DateTime
  description  String
  category     String?
  roomNumber   String?

  // Relation to Customer (optional)
  customerName String?
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])

  // NEW: Tenant payment verification fields
  receiptUrl   String?   // Uploaded JPG/PNG receipt
  isVerified   Boolean   @default(false) // Admin verified?
  status       String    @default("VERIFIED") // "PENDING" | "VERIFIED" | "REJECTED"
  rejectionReason String? // Reason if rejected

  user   User?   @relation(fields: [userId], references: [id])
  userId String?
}

model Room {
  id          String    @id @default(cuid())
  roomNumber  String    @unique
  status      String // "occupied" or "vacant"
  lastPayment DateTime?

  user   User?   @relation(fields: [userId], references: [id])
  userId String?
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  role         String        @default("ADMIN") // "ADMIN" or "TENANT"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Admin relations (only accessible by ADMIN role)
  customers    Customer[]
  transactions Transaction[]
  rooms        Room[]
  categories   Category[]

  // Tenant relation (one-to-one)
  tenantProfile Tenant?      // NEW: Tenant profile linked to user
}

model Category {
  id          String   @id @default(cuid())
  name        String
  type        String   // "expense" or "revenue"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  @@unique([name, userId, type])
}

// NEW: Tenant Profile Model
model Tenant {
  id          String    @id @default(cuid())
  userId      String    @unique  // Link to User (one-to-one)
  customerId  String    @unique  // Link to Customer (business record)
  active      Boolean   @default(true) // Account status
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  customer    Customer  @relation(fields: [customerId], references: [id])
  complaints  Complaint[]
}

// NEW: Complaint/Ticket Model
model Complaint {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  description String
  category    String    // "ELECTRICITY" | "PLUMBING" | "INTERNET" | "OTHER" | "CLEANING" | "SECURITY"
  status      String    @default("OPEN") // "OPEN" | "IN_PROGRESS" | "RESOLVED" | "CLOSED"
  imageUrl    String?   // Optional: Photo proof of issue
  adminReply  String?   // Admin response
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
}
