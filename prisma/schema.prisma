// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id          String        @id @default(cuid())
  name        String
  email       String?       // NEW: Email for customer lookup/selection
  phone       String
  nik         String        @unique
  entryDate   DateTime
  roomNumber  String?
  lastPayment DateTime?
  checkoutDate DateTime?
  Transaction Transaction[]
  Tenant      Tenant?       // NEW: One-to-one with Tenant

  user   User?   @relation(fields: [userId], references: [id])
  userId String?
}

model Transaction {
  id           String    @id @default(cuid())
  type         String // "revenue" or "expense"
  amount       Float
  date         DateTime
  description  String
  category     String?
  roomNumber   String?

  // Relation to Customer (optional)
  customerName String?
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])

  // NEW: Tenant payment verification fields
  receiptUrl   String?   // Uploaded JPG/PNG receipt
  isVerified   Boolean   @default(false) // Admin verified?
  status       String    @default("VERIFIED") // "PENDING" | "VERIFIED" | "REJECTED"
  rejectionReason String? // Reason if rejected

  user   User?   @relation(fields: [userId], references: [id])
  userId String?
}

model Room {
  id          String    @id @default(cuid())
  roomNumber  String    @unique
  status      String // "occupied" or "vacant"
  lastPayment DateTime?

  user   User?   @relation(fields: [userId], references: [id])
  userId String?
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  role         String        @default("ADMIN") // "ADMIN" or "TENANT"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Admin relations (only accessible by ADMIN role)
  customers    Customer[]
  transactions Transaction[]
  rooms        Room[]
  categories   Category[]
  buildingInfo BuildingInfo[] // NEW: Building information updates
  roomInfo     RoomInfo[]      // NEW: Room information updates
  tenantServerApps TenantServerApp[] // NEW: Tenant server app configurations

  // Tenant relation (one-to-one)
  tenantProfile Tenant?      // NEW: Tenant profile linked to user
}

model Category {
  id          String   @id @default(cuid())
  name        String
  type        String   // "expense" or "revenue"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  @@unique([name, userId, type])
}

// NEW: Tenant Profile Model
model Tenant {
  id          String    @id @default(cuid())
  userId      String    @unique  // Link to User (one-to-one)
  customerId  String    @unique  // Link to Customer (business record)
  active      Boolean   @default(true) // Account status
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  customer    Customer  @relation(fields: [customerId], references: [id])
  complaints  Complaint[]
  serverApps  TenantServerApp[] // NEW: Custom server apps for this tenant
}

// NEW: Complaint/Ticket Model
model Complaint {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  description String
  category    String    // "ELECTRICITY" | "PLUMBING" | "INTERNET" | "OTHER" | "CLEANING" | "SECURITY"
  status      String    @default("OPEN") // "OPEN" | "IN_PROGRESS" | "RESOLVED" | "CLOSED"
  imageUrl    String?   // Optional: Photo proof of issue
  adminReply  String?   // Admin response
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
}

// NEW: Building Information Model (shared by all tenants)
model BuildingInfo {
  id          String    @id @default(cuid())
  key         String    @unique // "wifi_password", "gate_code", etc.
  value       String    // The actual information
  category    String    // "general" | "security" | "contact"
  description String?   // Optional description
  isActive    Boolean   @default(true)
  updatedAt   DateTime  @updatedAt
  updatedBy   String?   // User ID of who last updated

  user        User?     @relation(fields: [updatedBy], references: [id])
}

// NEW: Room-Specific Information Model (private to each room)
model RoomInfo {
  id          String    @id @default(cuid())
  roomNumber  String    // Links to room
  key         String    // "electricity_token", "entry_date", "server_password", etc.
  value       String    // The actual information
  category    String    // "access" | "utilities" | "server" | "general"
  description String?   // Optional description
  updatedAt   DateTime  @updatedAt
  updatedBy   String?   // User ID of who last updated

  user        User?     @relation(fields: [updatedBy], references: [id])

  @@unique([roomNumber, key]) // One value per key per room
}

// NEW: Tenant Server Apps Configuration (per-tenant customizable apps)
model TenantServerApp {
  id          String    @id @default(cuid())
  tenantId    String    // Link to tenant
  appId       String    // App identifier (e.g., "jellyfin", "homeassistant")
  name        String    // Display name
  url         String    // Custom URL for this tenant
  icon        String    @default("🌐") // Icon emoji
  description String?   // Optional description
  category    String    @default("other") // "media" | "home" | "other"
  isActive    Boolean   @default(true)
  updatedAt   DateTime  @updatedAt
  updatedBy   String?   // Admin user ID who last updated

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  user        User?     @relation(fields: [updatedBy], references: [id])

  @@unique([tenantId, appId]) // One config per app per tenant
}
